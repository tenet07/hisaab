<% content_for :title, "Credit note" %>
<%= page_header "Credit note on #{@invoice.number}", "#{@invoice.bill_to_name} · #{d @invoice.invoice_date} · #{inr @invoice.total_paise}" %>
<%= form_with url: invoice_credit_notes_path(@invoice), class: "space-y-4", data: { turbo_confirm: "Post this credit note?" } do |f| %>
  <div class="card-pad grid gap-4 sm:grid-cols-3">
    <div class="field"><label class="label">Reason</label><%= f.select :reason, CreditNote::REASONS.invert.to_a, { selected: params[:reason] || "shortfall" }, class: "input" %></div>
    <div class="field"><label class="label">Pieces go to</label>
      <%= f.select :restock_bucket, [["Back to sellable stock", "sellable"], ["Awaiting brand claim (defective)", "awaiting_claim"], ["No stock movement (never left the shop / short delivery)", ""]], { selected: params[:reason] == "shortfall" ? "" : "sellable" }, class: "input" %>
      <p class="hint">Shortfall at delivery: pieces never left, choose “sellable” if they're back on the shelf.</p></div>
    <div class="field"><label class="label">Notes</label><%= f.text_field :notes, class: "input" %></div>
  </div>
  <div class="card">
    <table class="table">
      <thead><tr><th>Item</th><th class="num">Billed</th><th class="num">Already credited</th><th class="num">Net rate</th><th class="!text-right">Credit qty</th><th class="!text-right">Rate (for rate difference)</th></tr></thead>
      <tbody>
        <% @invoice.lines.each do |l| %>
          <% left = l.quantity - @credited[l.id].to_i %>
          <tr><td><%= l.description %></td><td class="num"><%= l.quantity %></td><td class="num text-slate-500"><%= @credited[l.id].to_i %></td>
            <td class="num"><%= inr (l.taxable_paise.to_d / l.quantity).round %></td>
            <td class="w-28"><%= number_field_tag "lines[#{l.id}][quantity]", nil, min: 0, max: left, class: "input text-right", disabled: left.zero?, placeholder: left.to_s %></td>
            <td class="w-36"><%= number_field_tag "lines[#{l.id}][rate]", nil, min: 0, step: "0.01", class: "input text-right", placeholder: "per piece, ex-GST" %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="flex items-center justify-end gap-4">
    <label class="flex items-center gap-2 text-sm"><%= check_box_tag :whatsapp, "1", true %> Send on WhatsApp</label>
    <%= f.submit "Post credit note", class: "btn-primary btn-lg" %>
  </div>
<% end %>
