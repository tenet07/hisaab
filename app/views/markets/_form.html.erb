<%= form_with model: @market, class: "card-pad max-w-xl space-y-4" do |f| %>
  <% if @market.errors.any? %><div class="rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= @market.errors.full_messages.to_sentence %></div><% end %>
  <div class="field"><%= f.label :name, class: "label" %><%= f.text_field :name, class: "input", required: true %></div>
  <div class="field"><%= f.label :delivery_weekday, "Route day", class: "label" %><%= f.select :delivery_weekday, Date::DAYNAMES.each_with_index.to_a, { include_blank: "—" }, class: "input" %></div>
  <div class="field"><%= f.label :salesman_id, class: "label" %><%= f.select :salesman_id, User.active.with_role("salesman").map { [_1.name, _1.id] }, { include_blank: "—" }, class: "input" %></div>
  <div class="field"><%= f.label :position, "Sort order", class: "label" %><%= f.number_field :position, class: "input" %></div>
  <%= f.submit "Save", class: "btn-primary" %>
<% end %>
