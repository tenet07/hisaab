<% { notice: ["border-emerald-200 bg-emerald-50 text-emerald-800", "check-circle"], alert: ["border-rose-200 bg-rose-50 text-rose-800", "alert"] }.each do |key, (cls, ic)| %>
  <% if flash[key].present? %>
    <div class="fixed top-4 left-1/2 z-50 -translate-x-1/2" data-controller="dismiss" data-dismiss-after-value="<%= key == :notice ? 4000 : 9000 %>">
      <div class="flex max-w-lg items-start gap-2.5 rounded-xl border px-4 py-3 text-sm shadow-lg <%= cls %>">
        <%= icon ic, class: "mt-0.5 size-4 shrink-0" %><span class="flex-1"><%= flash[key] %></span>
        <button type="button" data-action="dismiss#close" class="opacity-60 hover:opacity-100"><%= icon "x", class: "size-4" %></button>
      </div>
    </div>
  <% end %>
<% end %>
