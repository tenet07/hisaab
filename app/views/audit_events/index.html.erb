<% content_for :title, "Audit trail" %>
<%= page_header "Audit trail", "Every entry carries who, when and which device. Nothing is deleted — corrections are reversing entries." %>
<div class="tabs mb-4">
  <%= link_to "Ledger postings", audit_events_path(tab: "postings"), class: ["tab", ("active" if @tab == "postings")] %>
  <%= link_to "Master changes & actions", audit_events_path(tab: "changes"), class: ["tab", ("active" if @tab == "changes")] %>
</div>
<div class="card overflow-x-auto">
  <% if @tab == "postings" %>
    <table class="table"><thead><tr><th>When</th><th>Who</th><th>Device</th><th>Party</th><th>Entry</th><th class="num">Dr</th><th class="num">Cr</th></tr></thead>
      <tbody><% @rows.each do |e| %><tr><td class="whitespace-nowrap text-slate-500"><%= dt e.created_at %></td><td><%= e.user&.name || "system" %></td><td class="text-xs text-slate-500"><%= e.device %></td>
        <td><%= e.party.try(:shop_name) || e.party.try(:name) %></td><td><%= e.narration %></td><td class="num"><%= inr e.debit_paise if e.debit_paise.positive? %></td><td class="num"><%= inr e.credit_paise if e.credit_paise.positive? %></td></tr><% end %></tbody></table>
  <% else %>
    <table class="table"><thead><tr><th>When</th><th>Who</th><th>Device</th><th>What</th><th>Action</th><th>Changes</th></tr></thead>
      <tbody><% @rows.each do |a| %><tr><td class="whitespace-nowrap text-slate-500"><%= dt a.created_at %></td><td><%= a.user&.name || "system" %></td><td class="text-xs text-slate-500"><%= a.device %></td>
        <td><%= a.subject_type %> <%= a.subject.try(:number) || a.subject.try(:name) || a.subject.try(:shop_name) || "##{a.subject_id}" %></td><td><span class="badge-gray"><%= a.action %></span></td>
        <td class="max-w-md text-xs text-slate-500"><%= a.changeset.map { |k, v| "#{k}: #{v.is_a?(Array) ? v.map { _1.to_s.truncate(30) }.join(' → ') : v.to_s.truncate(40)}" }.first(4).join(" · ") %></td></tr><% end %></tbody></table>
  <% end %>
</div>
