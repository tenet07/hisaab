<% content_for :title, "Stock movements" %>
<%= page_header "Stock movements", "The append-only stock ledger" %>
<%= form_with url: stock_movements_path, method: :get, class: "card mb-4 flex flex-wrap items-end gap-3 p-3" do |f| %>
  <div><label class="label">Reason</label><%= f.select :reason, StockMovement::REASONS.map { [_1.humanize, _1] }, { include_blank: "All", selected: params[:reason] }, class: "input" %></div>
  <div><label class="label">Bucket</label><%= f.select :bucket, StockMovement::BUCKET_LABELS.invert.to_a, { include_blank: "All", selected: params[:bucket] }, class: "input" %></div>
  <div><label class="label">Since</label><%= f.date_field :from, value: params[:from], class: "input" %></div>
  <%= f.submit "Filter", class: "btn" %>
<% end %>
<div class="card overflow-x-auto">
  <table class="table">
    <thead><tr><th>When</th><th>Product</th><th>Bucket</th><th>Reason</th><th>Document</th><th>By · device</th><th class="num">Qty</th></tr></thead>
    <tbody>
      <% @movements.each do |m| %>
        <tr><td class="whitespace-nowrap text-slate-500"><%= dt m.created_at %></td><td><%= link_to m.product.display_name, m.product, class: "hover:underline" %></td><td><%= bucket_badge m.bucket %></td>
          <td><%= m.reason.humanize %><% if m.note.present? %><div class="text-xs text-slate-500"><%= m.note %></div><% end %></td>
          <td class="text-xs"><%= m.document.try(:number) || m.document&.model_name&.human %></td><td class="text-xs text-slate-500"><%= m.user&.name %> · <%= m.device %></td>
          <td class="num font-medium <%= m.quantity.positive? ? 'text-emerald-700' : '' %>"><%= m.quantity.positive? ? "+#{m.quantity}" : m.quantity %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
