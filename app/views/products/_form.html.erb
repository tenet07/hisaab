<%= form_with model: @product, class: "form panel panel-pad" do |f| %>
  <% if @product.errors.any? %><div class="errors" role="alert"><%= @product.errors.full_messages.to_sentence %></div><% end %>
  <div class="fields two">
    <div class="field"><%= f.label :brand, class: "lbl" %><%= f.text_field :brand, required: true %></div>
    <div class="field"><%= f.label :sku, "Product code (SKU)", class: "lbl" %><%= f.text_field :sku, required: true, autocapitalize: "characters" %></div>
  </div>
  <div class="field"><%= f.label :name, class: "lbl" %><%= f.text_field :name, required: true, placeholder: "e.g. LED Bulb 9W" %></div>
  <div class="fields two">
    <div class="field"><%= f.label :hsn, "HSN", class: "lbl" %><%= f.text_field :hsn, required: true, inputmode: "numeric" %></div>
    <div class="field"><%= f.label :gst_bp, "GST", class: "lbl" %><%= f.select :gst_bp, [["0%", 0], ["5%", 500], ["12%", 1200], ["18%", 1800], ["28%", 2800]] %></div>
  </div>
  <div class="fields two">
    <div class="field"><label class="lbl" for="product_wholesale_price">Wholesale price</label><div class="money-in"><%= text_field_tag "product[wholesale_price]", rs_input(@product.wholesale_price_paise), required: true, inputmode: "decimal", id: "product_wholesale_price" %></div></div>
    <div class="field"><label class="lbl" for="product_retail_price">Retail price</label><div class="money-in"><%= text_field_tag "product[retail_price]", rs_input(@product.retail_price_paise), required: true, inputmode: "decimal", id: "product_retail_price" %></div></div>
  </div>
  <label class="check"><%= f.check_box :price_includes_tax %> Prices already include GST (MRP-style)</label>
  <div class="fields two">
    <div class="field"><%= f.label :warranty_months, "Warranty (months)", class: "lbl" %><%= f.number_field :warranty_months, min: 0, inputmode: "numeric" %><span class="hint">0 means no warranty</span></div>
    <div class="field"><%= f.label :reorder_level, "Reorder when stock reaches", class: "lbl" %><%= f.number_field :reorder_level, min: 0, inputmode: "numeric" %></div>
  </div>
  <% if @product.new_record? %><div class="field"><label class="lbl" for="opening_qty">Opening stock</label><%= number_field_tag :opening_qty, nil, min: 0, inputmode: "numeric" %></div><% end %>
  <%= f.submit (@product.new_record? ? "Add product" : "Save changes"), class: "btn btn-lg" %>
<% end %>
