<%= form_with model: @product, class: "card-pad max-w-3xl space-y-4" do |f| %>
  <% if @product.errors.any? %><div class="rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= @product.errors.full_messages.to_sentence %></div><% end %>
  <div class="grid gap-4 sm:grid-cols-3">
    <div class="field"><%= f.label :brand_id, class: "label" %><%= f.select :brand_id, Brand.all.map { [_1.name, _1.id] }, {}, class: "input" %></div>
    <div class="field sm:col-span-2"><%= f.label :name, class: "label" %><%= f.text_field :name, class: "input", required: true %></div>
    <div class="field"><%= f.label :sku, "SKU", class: "label" %><%= f.text_field :sku, class: "input uppercase", required: true %></div>
    <div class="field"><%= f.label :model, class: "label" %><%= f.text_field :model, class: "input" %></div>
    <div class="field"><%= f.label :wattage, class: "label" %><%= f.text_field :wattage, class: "input", placeholder: "9W" %></div>
    <div class="field"><%= f.label :hsn, "HSN", class: "label" %><%= f.text_field :hsn, class: "input", required: true, placeholder: "85395000" %></div>
    <div class="field"><%= f.label :gst_rate, "GST %", class: "label" %><%= f.select :gst_rate, [0, 5, 12, 18, 28].map { [_1, _1] }, { selected: @product.gst_rate.to_i }, class: "input" %></div>
    <div class="field"><%= f.label :warranty_months, "Warranty months (blank = brand's)", class: "label" %><%= f.number_field :warranty_months, class: "input" %></div>
    <div class="field"><%= f.label :mrp, "MRP ₹", class: "label" %><%= f.number_field :mrp, step: "0.01", class: "input" %></div>
    <div class="field"><%= f.label :wholesale, "Wholesale ₹ (ex-GST)", class: "label" %><%= f.number_field :wholesale, step: "0.01", class: "input" %></div>
    <div class="field"><%= f.label :retail, "Retail ₹ (incl. GST)", class: "label" %><%= f.number_field :retail, step: "0.01", class: "input" %></div>
    <div class="field"><%= f.label :purchase, "Purchase ₹", class: "label" %><%= f.number_field :purchase, step: "0.01", class: "input" %></div>
    <div class="field"><%= f.label :reorder_level, class: "label" %><%= f.number_field :reorder_level, class: "input" %></div>
    <% if @product.new_record? %><div class="field"><label class="label">Opening stock</label><%= number_field_tag :opening_stock, nil, class: "input" %></div><% end %>
  </div>
  <div class="field"><%= f.label :aliases, "What customers call it (comma separated — helps the WhatsApp order parser)", class: "label" %><%= f.text_area :aliases, rows: 2, class: "input", placeholder: "9 watt bulb, philips 9w" %></div>
  <% if @product.persisted? %><label class="flex items-center gap-2 text-sm"><%= f.check_box :active %> Active</label><% end %>
  <div class="flex justify-end gap-2"><%= link_to "Cancel", products_path, class: "btn" %><%= f.submit "Save", class: "btn-primary" %></div>
<% end %>
