<% content_for :title, "Settings" %>
<%= page_header "Settings" %>
<%= render "settings/nav" %>
<%= form_with model: @s, url: settings_path, method: :patch, class: "space-y-5 max-w-4xl" do |f| %>
  <% if @s.errors.any? %><div class="rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= @s.errors.full_messages.to_sentence %></div><% end %>
  <div class="card-pad space-y-4">
    <div class="card-title">Shop</div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="field"><%= f.label :name, "Display name", class: "label" %><%= f.text_field :name, class: "input" %></div>
      <div class="field"><%= f.label :legal_name, "Legal name (on invoices)", class: "label" %><%= f.text_field :legal_name, class: "input" %></div>
      <div class="field"><%= f.label :gstin, "GSTIN", class: "label" %><%= f.text_field :gstin, class: "input uppercase" %></div>
      <div class="field"><%= f.label :state_code, "State", class: "label" %><%= f.select :state_code, GstStates.options, {}, class: "input" %></div>
      <div class="field"><%= f.label :phone, class: "label" %><%= f.text_field :phone, class: "input" %></div>
      <div class="field"><%= f.label :email, class: "label" %><%= f.email_field :email, class: "input" %></div>
      <div class="field"><%= f.label :upi_id, "UPI ID (QR on invoices)", class: "label" %><%= f.text_field :upi_id, class: "input", placeholder: "shop@okhdfc" %></div>
      <div class="field"><%= f.label :invoice_prefix, class: "label" %><%= f.text_field :invoice_prefix, class: "input" %><p class="hint">Numbers look like <%= @s.invoice_prefix %>/<%= FinancialYear.for(Date.current) %>/00001 and restart each April.</p></div>
    </div>
    <div class="field"><%= f.label :address, class: "label" %><%= f.text_area :address, rows: 2, class: "input" %></div>
    <div class="field"><%= f.label :bank_details, "Bank details (printed on invoices)", class: "label" %><%= f.text_field :bank_details, class: "input" %></div>
  </div>
  <div class="card-pad space-y-4">
    <div class="card-title">Rules</div>
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="field"><%= f.label :credit_days, "Default credit days", class: "label" %><%= f.number_field :credit_days, class: "input" %></div>
      <div class="field"><%= f.label :discount_approval_pct, "Discount above this % needs owner", class: "label" %><%= f.number_field :discount_approval_pct, step: "0.5", class: "input" %></div>
      <div class="field"><%= f.label :writeoff_approval, "Count adjustments above ₹ need owner (0 = always allowed)", class: "label" %><%= f.number_field :writeoff_approval, value: @s.writeoff_approval.to_i, class: "input" %></div>
      <div class="field"><%= f.label :claim_flag_days, "Flag brand claims with no response after (days)", class: "label" %><%= f.number_field :claim_flag_days, class: "input" %></div>
      <div class="field"><%= f.label :eway_threshold, "E-way bill above ₹", class: "label" %><%= f.number_field :eway_threshold, value: @s.eway_threshold.to_i, class: "input" %></div>
      <div class="field"><label class="label">E-invoicing (turnover over ₹5 Cr)</label><label class="flex items-center gap-2 pt-2 text-sm"><%= f.check_box :einvoice_enabled %> Generate IRN via GST API provider</label></div>
    </div>
  </div>
  <div class="card-pad space-y-4">
    <div class="card-title">WhatsApp</div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="field"><%= f.label :whatsapp_provider, "Provider", class: "label" %><%= f.select :whatsapp_provider, [["Log only (no messages leave)", "log"], ["WhatsApp Cloud API", "cloud"]], {}, class: "input" %></div>
      <div class="text-sm text-slate-600">
        Status: <%= Whatsapp::Provider::Cloud.configured? ? tag.span("Cloud API connected", class: "badge-green") : tag.span("Not connected", class: "badge-amber") %>
        <p class="hint mt-1">Set WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_VERIFY_TOKEN and WHATSAPP_APP_SECRET on the server. Webhook URL: <code><%= request.base_url %>/whatsapp/webhook</code>. Templates to get approved: invoice_issued, delivery_done, payment_receipt, credit_note_issued, overdue_reminder, monthly_statement (utility), market_offer (marketing).</p>
      </div>
    </div>
    <div class="text-sm text-slate-600">AI order reading: <%= OrderParser::Llm.enabled? ? tag.span("Claude connected", class: "badge-green") : tag.span("Using built-in matcher — set ANTHROPIC_API_KEY for AI", class: "badge-amber") %></div>
  </div>
  <div class="flex justify-end"><%= f.submit "Save settings", class: "btn-primary" %></div>
<% end %>
