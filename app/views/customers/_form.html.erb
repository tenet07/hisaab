<%= form_with model: @customer, class: "card-pad space-y-4 max-w-3xl" do |f| %>
  <% if @customer.errors.any? %><div class="rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= @customer.errors.full_messages.to_sentence %></div><% end %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="field"><%= f.label :shop_name, class: "label" %><%= f.text_field :shop_name, class: "input", required: true %></div>
    <div class="field"><%= f.label :owner_name, class: "label" %><%= f.text_field :owner_name, class: "input" %></div>
    <div class="field"><%= f.label :phone, "WhatsApp number", class: "label" %><%= f.telephone_field :phone, value: @customer.phone.to_s.delete_prefix("91"), class: "input", required: true, placeholder: "98XXXXXXXX" %></div>
    <div class="field"><%= f.label :gstin, "GSTIN (blank for B2C)", class: "label" %><%= f.text_field :gstin, class: "input uppercase", maxlength: 15 %></div>
    <div class="field"><%= f.label :market_id, class: "label" %><%= f.select :market_id, Market.all.map { [_1.name, _1.id] }, { include_blank: "—" }, class: "input" %></div>
    <div class="field"><%= f.label :price_tier, class: "label" %><%= f.select :price_tier, Customer::TIERS.map { [_1.humanize, _1] }, {}, class: "input" %></div>
    <% if Current.user.owner? || Current.user.accounts? %>
      <div class="field"><%= f.label :credit_limit, "Credit limit ₹ (0 = none)", class: "label" %><%= f.number_field :credit_limit, value: @customer.credit_limit.to_i, class: "input" %></div>
    <% end %>
    <div class="field"><%= f.label :state_code, "State (if no GSTIN)", class: "label" %><%= f.select :state_code, GstStates.options, { include_blank: "Same as shop" }, class: "input" %></div>
    <% if @customer.new_record? %><div class="field"><label class="label">Opening balance ₹ (they owe; negative = advance)</label><%= number_field_tag :opening_balance, nil, step: "0.01", class: "input" %></div><% end %>
  </div>
  <div class="field"><%= f.label :address, class: "label" %><%= f.text_area :address, rows: 2, class: "input" %></div>
  <label class="flex items-center gap-2 text-sm"><%= f.check_box :marketing_opt_in %> Agreed to receive offers on WhatsApp</label>
  <% if @customer.persisted? %><label class="flex items-center gap-2 text-sm"><%= f.check_box :active %> Active</label><% end %>
  <div class="flex justify-end gap-2"><%= link_to "Cancel", @customer.persisted? ? @customer : customers_path, class: "btn" %><%= f.submit "Save", class: "btn-primary" %></div>
<% end %>
