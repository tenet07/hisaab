<% content_for :title, "Purchase bill" %>
<%= page_header "Enter purchase bill" %>
<%= catalog_script "product-catalog", product_catalog_json %>
<%= form_with url: purchases_path, class: "space-y-4", data: { controller: "lines", lines_rate_key_value: "purchase", lines_inclusive_value: false } do |f| %>
  <div class="card-pad grid gap-4 sm:grid-cols-3">
    <div class="field"><label class="label">Supplier</label><%= f.select :supplier_id, Supplier.order(:name).map { [_1.name, _1.id] }, { selected: @purchase.supplier_id }, class: "input" %></div>
    <div class="field"><label class="label">Supplier bill no.</label><%= f.text_field :bill_no, class: "input", required: true %></div>
    <div class="field"><label class="label">Bill date</label><%= f.date_field :bill_date, value: @purchase.bill_date, class: "input" %></div>
  </div>
  <div class="card">
    <%= render "shared/lines_table", prefix: "lines", lines: [], show_disc: false, rate_label: "Cost" %>
    <div class="flex items-center justify-end gap-6 border-t border-slate-100 bg-slate-50/60 px-5 py-3 text-sm">
      <span class="text-slate-500">Taxable <span class="tnum text-slate-800" data-lines-target="taxable"></span></span>
      <span class="text-slate-500">GST <span class="tnum text-slate-800" data-lines-target="tax"></span></span>
      <span class="text-base font-semibold">Total <span class="tnum" data-lines-target="total"></span></span>
    </div>
  </div>
  <div class="flex justify-end"><%= f.submit "Post purchase", class: "btn-primary btn-lg" %></div>
<% end %>
