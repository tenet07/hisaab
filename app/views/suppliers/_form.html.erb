<%= form_with model: @supplier, class: "card-pad max-w-2xl space-y-4" do |f| %>
  <% if @supplier.errors.any? %><div class="rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= @supplier.errors.full_messages.to_sentence %></div><% end %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="field"><%= f.label :name, class: "label" %><%= f.text_field :name, class: "input", required: true %></div>
    <div class="field"><%= f.label :brand_id, "Brand (for warranty claims)", class: "label" %><%= f.select :brand_id, Brand.all.map { [_1.name, _1.id] }, { include_blank: "—" }, class: "input" %></div>
    <div class="field"><%= f.label :gstin, "GSTIN", class: "label" %><%= f.text_field :gstin, class: "input" %></div>
    <div class="field"><%= f.label :phone, class: "label" %><%= f.text_field :phone, class: "input" %></div>
  </div>
  <div class="field"><%= f.label :address, class: "label" %><%= f.text_area :address, rows: 2, class: "input" %></div>
  <%= f.submit "Save", class: "btn-primary" %>
<% end %>
