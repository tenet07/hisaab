<%= form_with model: @user, class: "card-pad max-w-xl space-y-4" do |f| %>
  <% if @user.errors.any? %><div class="rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= @user.errors.full_messages.to_sentence %></div><% end %>
  <div class="field"><%= f.label :name, class: "label" %><%= f.text_field :name, class: "input", required: true %></div>
  <div class="field"><%= f.label :email_address, "Email (login)", class: "label" %><%= f.email_field :email_address, class: "input", required: true %></div>
  <div class="field"><%= f.label :phone, class: "label" %><%= f.text_field :phone, class: "input" %></div>
  <div class="field"><%= f.label :role, class: "label" %><%= f.select :role, User::ROLE_LABELS.invert.to_a, {}, class: "input" %></div>
  <div class="field"><%= f.label :password, @user.new_record? ? "Password" : "New password (blank = keep)", class: "label" %><%= f.password_field :password, class: "input", required: @user.new_record?, autocomplete: "new-password" %></div>
  <% if @user.persisted? %><label class="flex items-center gap-2 text-sm"><%= f.check_box :active %> Active (unticking signs them out everywhere)</label><% end %>
  <%= f.submit "Save", class: "btn-primary" %>
<% end %>
