<%= form_with model: @brand, class: "card-pad max-w-xl space-y-4" do |f| %>
  <% if @brand.errors.any? %><div class="rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= @brand.errors.full_messages.to_sentence %></div><% end %>
  <div class="field"><%= f.label :name, class: "label" %><%= f.text_field :name, class: "input", required: true %></div>
  <div class="field"><%= f.label :warranty_months, "Default warranty (months)", class: "label" %><%= f.number_field :warranty_months, class: "input" %></div>
  <div class="field"><%= f.label :claim_contact, "Where claims go", class: "label" %><%= f.text_field :claim_contact, class: "input" %></div>
  <%= f.submit "Save", class: "btn-primary" %>
<% end %>
