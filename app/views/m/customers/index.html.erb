<% content_for :title, "Shops" %>
<%= form_with url: m_customers_path, method: :get do |f| %><%= f.search_field :q, value: params[:q], class: "input-lg", placeholder: "Search shop, owner, phone" %><% end %>
<div class="space-y-2">
  <% @customers.each do |c| %>
    <%= link_to m_customer_path(c), class: "m-tap" do %><div class="min-w-0 flex-1"><div class="truncate font-medium"><%= c.shop_name %></div><div class="text-xs text-slate-500"><%= c.market&.name %></div></div><%= icon "chevron-right", class: "size-4 text-slate-300" %><% end %>
  <% end %>
</div>

