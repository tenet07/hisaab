# Copied to .env by deploy/server-setup.sh with real random values. Never share .env.
APP_HOST=bills.yourshop.in
SECRET_KEY_BASE=change-me-run-openssl-rand-hex-64
SETUP_CODE=change-me
BACKUP_AT=23:30
KEEP_DAYS=30

# Off-server copy to Cloudflare R2 (DEPLOY.md step 3). Fill these, then uncomment COMPOSE_PROFILES.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=shop-backups
R2_PATH=shop
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# COMPOSE_PROFILES=r2
