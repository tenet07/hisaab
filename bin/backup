#!/usr/bin/env bash
# Daily backup: dumps the database (with the ledger triggers) and uploaded photos, keeps 30 days,
# and copies them off the server when BACKUP_S3_URI is set (any S3-compatible store, e.g. an
# India-region bucket). Cron: 30 2 * * * /srv/hisaab/bin/backup >> /var/log/hisaab-backup.log 2>&1
set -euo pipefail
DIR=${BACKUP_DIR:-/var/backups/hisaab}
STAMP=$(date +%F-%H%M)
mkdir -p "$DIR"
pg_dump --format=custom --no-owner "${DATABASE_URL:?set DATABASE_URL}" > "$DIR/hisaab-$STAMP.dump"
if [ -d "${STORAGE_DIR:-storage}" ]; then tar -czf "$DIR/storage-$STAMP.tgz" -C "${STORAGE_DIR:-storage}" .; fi
find "$DIR" -type f -mtime +30 -delete
if [ -n "${BACKUP_S3_URI:-}" ]; then
  aws s3 cp "$DIR/hisaab-$STAMP.dump" "$BACKUP_S3_URI/" ${BACKUP_S3_ENDPOINT:+--endpoint-url "$BACKUP_S3_ENDPOINT"}
  [ -f "$DIR/storage-$STAMP.tgz" ] && aws s3 cp "$DIR/storage-$STAMP.tgz" "$BACKUP_S3_URI/" ${BACKUP_S3_ENDPOINT:+--endpoint-url "$BACKUP_S3_ENDPOINT"}
fi
echo "Backup $STAMP done"
